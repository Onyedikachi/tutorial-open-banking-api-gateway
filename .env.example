PORT=4000

# Where tutorial-open-api's core banking backend is reachable from this
# gateway (its browser-facing :3000, not published to TPPs directly).
CORE_BANKING_URL=http://localhost:3000

REDIS_HOST=localhost
REDIS_PORT=6380

# Must match the value nginx forwards - same value as
# docker-compose.yml's MTLS_GATEWAY_SECRET (set in a .env next to this one).
MTLS_GATEWAY_SECRET=

# Must match tutorial-open-api's INTERNAL_GATEWAY_SECRET.
INTERNAL_GATEWAY_SECRET=
